# ==============================================================================
# DOMJUDGE WIZARD - CONFIGURAÇÕES DE AMBIENTE (.env)
# ==============================================================================

# Porta na qual o serviço será exposto no host (padrão: 7070)
PORT=7070

# URL Base da API do DOMjudge (ex.: https://coderunner.cin.ufpe.br/api/v4)
DOMJUDGE_API_BASE=https://coderunner.cin.ufpe.br/api/v4

# Credenciais pré-configuradas para login automático (opcional para uso em localhost)
DOMJUDGE_API_USER=
DOMJUDGE_API_PASSWORD=

# Tempo em dias para expiração das credenciais salvas no navegador (padrão: 7)
STORAGE_EXPIRATION_DAYS=7
