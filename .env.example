# ==============================================================================
# DOMJUDGE EDU - VARIÁVEIS DE AMBIENTE DE EXEMPLO (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais do DOMjudge.
# ==============================================================================

# Porta do servidor web (padrão: 7070)
PORT=7070

# URL da API REST do DOMjudge (ex.: https://coderunner.cin.ufpe.br/api/v4)
DOMJUDGE_API_URL=https://coderunner.cin.ufpe.br/api/v4

# Credenciais administrativas do DOMjudge (usadas pelo backend proxy para autenticação e gestão)
DOMJUDGE_ADMIN_USER=admin
DOMJUDGE_ADMIN_PASSWORD=

# Label no DOMjudge que concede privilégios totais de administrador no Wizard
WIZARD_ADMIN_LABEL=admin

# Tempo de validade das sessões em dias (padrão: 7)
SESSION_EXPIRATION_DAYS=7
